# 复制本文件为 .env，把 Key 填进去即可。
# ⚠️ .env 已在 .gitignore 里 —— 只提交本文件（.env.example），永远不要提交 .env。

# ---------------------------------------------------------------------------
# 通义千问（阿里云百炼 · OpenAI 兼容接口）
# ---------------------------------------------------------------------------
# 两个硬要求（违反会直接报错或封 Key）：
#   1. 必须用「按量付费」的 Key。Token Plan / Coding Plan 用于本场景属违规。
#   2. 必须用「默认业务空间」的 Key。子空间 Key 会报 Invalid API-key provided。
# Key 获取：阿里云百炼控制台 → API-KEY → 创建我的 API-KEY
DASHSCOPE_API_KEY=sk-在这里粘贴你的Key

# Key 与地域绑定，别配错：
#   北京（华北2）= https://dashscope.aliyuncs.com/compatible-mode/v1
#   新加坡       = https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

CHAT_MODEL=qwen-plus
TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# 本地向量库与模型（一般不用改）
# ---------------------------------------------------------------------------
# ⚠️ CHROMA_DIR 必须是**纯 ASCII 路径** —— chromadb 在中文路径下不写 HNSW 索引！
CHROMA_DIR=D:\WorkBuddy\chroma_db
CHROMA_COLLECTION=standards

# 必须与建库时一致，换模型 = 换向量空间 = 旧库作废
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
HF_HOME=D:\WorkBuddy\models\hf

TOP_K=5

# ---------------------------------------------------------------------------
# 可选：语料路径（默认 <项目根>\输出文档\chunks_v5\chunks.jsonl）
# ---------------------------------------------------------------------------
# CHUNKS_FILE=
