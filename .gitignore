# =============================================================
# 本仓库只追踪「自研代码与文档」。
# 第三方素材、可再生的中间产物、大体积文件一律不入库。
# =============================================================

# ---- 第三方素材：受版权保护，不得公开发布 ----
建筑规范PDF/*.pdf

# ---- 中间产物：体积大，且可由脚本随时重新生成 ----
建筑规范PDF/ocr_text/
建筑规范PDF/chunks/
建筑规范PDF/_pilot/
建筑规范PDF/_ocr_test/
建筑规范PDF/*.json
建筑规范PDF/*.csv
建筑规范PDF/*.log

# ---- 本机输出目录：产物不入库，但自研脚本与说明文档要留 ----
输出文档/*
!输出文档/scripts/
!输出文档/scripts/*.py
!输出文档/scripts/*.sh
!输出文档/*.md

# ---- WorkBuddy 工作区数据（会话记忆等，非项目代码）----
.workbuddy/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---- 编辑器 / 操作系统 ----
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
*~
